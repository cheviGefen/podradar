# Copy this file to .env and choose your own passwords. Docker Compose reads .env by itself,
# and .env is ignored by git, so the real passwords never reach the repository.
# Letters and digits only: the app password goes into a connection URL.

# MongoDB's admin user, for maintenance only
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me

# The user the server connects with; it may only read and write the podradar database
MONGO_APP_USERNAME=podradar
MONGO_APP_PASSWORD=change-me-too
