# A template: when the container starts, the nginx image fills in ${...} from environment variables
# and writes the result to /etc/nginx/conf.d/default.conf.

server {
    # The unprivileged nginx image runs without root, and only root may listen on ports below 1024
    listen 8080;
    root /usr/share/nginx/html;

    # Look the server's address up on every request (cached for 10s), with the DNS servers from
    # /etc/resolv.conf, instead of once at startup. That way nginx starts even before the server
    # exists, and keeps working when the server restarts with a new IP.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    # Fail fast when the server is down, instead of the default 30-60 seconds of waiting
    resolver_timeout 3s;
    proxy_connect_timeout 3s;

    # The API lives in the server container. API_UPSTREAM defaults to server:8000, its name in
    # docker-compose. Note: nginx's resolver ignores DNS search domains, so in Kubernetes it must be
    # the full Service name, e.g. server.podradar.svc.cluster.local:8000.
    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
    }

    # Everything else is the React app
    location / {
        try_files $uri /index.html;
    }
}
