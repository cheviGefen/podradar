{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"],
  // Tests run straight from TypeScript with tsx, so they stay out of dist/ and out of the image
  "exclude": ["src/**/*.test.ts"]
}
